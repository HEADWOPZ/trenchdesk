# TrenchDesk local configuration
# Copy to .env — all keys are optional for v1.

# --- Runtime ---
PORT=8787
HOST=0.0.0.0
TRENCHDESK_DB=./data/trenchdesk.sqlite

# live = public feeds (default). mock = offline fixture feed.
# live automatically falls back to mock if every source fails.
FEED_MODE=live
POLL_INTERVAL_MS=30000

# --- Optional enrichment ---
# Birdeye public API key (holder concentration / security). Leave blank to skip.
BIRDEYE_API_KEY=

# --- Telegram alerts ---
# When either is unset, alerts dry-run to the API log (and /api/alerts).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_MIN_SCORE=70

# --- Optional LLM for the desk chat panel ---
# Offline rule-based explainer always works. LLM only paraphrases stored features.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
